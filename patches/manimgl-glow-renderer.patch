+# Light that adds to whatever is behind it rather than tinting it -- the way a glow
+# has to behave to read as light, since tinting can only darken a bright background.
+# Asked for by name on a mobject: mob.blend_mode = "add".
+BLEND_ADD = {
+    "color": {
+        # Source light scaled by its own alpha -- where a glow shader has put
+        # its falloff -- then added to whatever is behind: the classic
+        # (SRC_COLOUR * SRC_ALPHA) + DST_COLOUR. Plain one/one would ignore
+        # the falloff and add full strength across the whole quad.
+        "src_factor": wgpu.BlendFactor.src_alpha,
+        "dst_factor": wgpu.BlendFactor.one,
+        "operation": wgpu.BlendOperation.add,
+    },
+    "alpha": {
+        "src_factor": wgpu.BlendFactor.one,
+        "dst_factor": wgpu.BlendFactor.one,
+        "operation": wgpu.BlendOperation.add,
+    },
+}
+BLENDS = {"alpha": BLEND, "add": BLEND_ADD}
+
 
 @dataclass(frozen=True)
 class PipelineState:
